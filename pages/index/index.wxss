/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
swiper{
 height: 350rpx;
}
swiper image{
  width: 100%;
  height: 100%;
}
.grids{
  display: flex;
  flex-wrap: wrap;
}
.grids .item{
  width: 247rpx;
  height: 247rpx;
  border-right: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.grids image{
  width: 70rpx;
  height: 70rpx;
}